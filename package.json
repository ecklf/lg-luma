{
  "name": "lg-luma",
  "version": "2.2.0",
  "private": true,
  "description": "A modern, remote-first webOS launcher.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "cargo run --locked --",
    "build": "sh tools/build-webos.sh",
    "package": "pnpm assets && pnpm build && node tools/package.mjs && node tools/repository.mjs",
    "deploy": "pnpm run package && node tools/deploy.mjs",
    "test": "pnpm test:release && pnpm test:icons && cargo test --locked --workspace --all-features",
    "test:release": "node --test tests/release.test.mjs",
    "test:icons": "node --test tests/read-app-icon.test.mjs tests/brand-assets.test.mjs",
    "test:smoke": "node tests/smoke.mjs && node tests/brands-smoke.mjs && node tests/weather-smoke.mjs && node tests/translations-smoke.mjs",
    "test:brands": "node tests/brands-smoke.mjs",
    "check": "pnpm version:check && pnpm lint && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "cargo fmt --all && oxfmt --write .",
    "format:check": "cargo fmt --all -- --check && oxfmt --check .",
    "assets": "node tools/assets.mjs",
    "screenshots": "pnpm assets && node tools/screenshots.mjs",
    "assets:vector": "node tools/vector-assets.mjs",
    "assets:brands": "node tools/brand-assets.mjs",
    "assets:fonts": "node tools/font-assets.mjs",
    "runtime": "node tools/webos-runtime.mjs",
    "sdk": "node tools/setup-webos-sdk.mjs",
    "test:weather": "node tests/weather-smoke.mjs",
    "test:translations": "node tests/translations-smoke.mjs",
    "changeset": "changeset",
    "version:release": "changeset version && pnpm version:sync && oxfmt --write CHANGELOG.md",
    "version:sync": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@webos-tools/cli": "3.2.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "sharp": "0.35.5"
  }
}
